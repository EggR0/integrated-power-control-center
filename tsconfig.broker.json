{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "./broker-out/broker",
    "rootDir": "./src/broker",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "declaration": true
  },
  "include": ["src/broker/**/*"]
}
